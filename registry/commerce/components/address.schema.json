{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commerce.address",
  "type": "object",
  "properties": {
    "line1": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postalCode": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code."
    }
  },
  "required": ["line1", "city", "postalCode", "country"]
}
