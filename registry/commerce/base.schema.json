{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commerce.base",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this record."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was created."
    },
    "tenantId": {
      "type": "string",
      "description": "Owning tenant identifier."
    },
    "region": {
      "type": "string",
      "description": "Data residency region."
    },
    "details": {
      "type": "object",
      "additionalProperties": true,
      "description": "Schema-specific extra data. Shape varies per schema — base only requires the object itself to be present."
    }
  },
  "required": [
    "id",
    "createdAt",
    "tenantId",
    "region",
    "details"
  ]
}
